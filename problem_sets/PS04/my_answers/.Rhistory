# Create new variable:
Prestige$professional <- ifelse(Prestige$type == "prof", 1, 0)
# Check that it worked:
table(Prestige$type, Prestige$professional)
lm(Prestige$prestige ~ Prestige$income + Prestige$professional)
model_1b <- lm(prestige ~ income + professional + income*professional, data = Prestige)
summary(model_1b)
#predicted prestige = Intercept + (Income coefficient x Income) + (Professional coefficient x professional) + (Interaction coefficient of professional and income x income x professional)
model_1b$coefficients[["income"]]
model_1b$coefficients[["Intercept"]]
model_1b$coefficients[["(Intercept)"]]
